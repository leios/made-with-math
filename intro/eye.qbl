quibble_point_2D stretch(quibble_point_2D pt, float stretch_factor){
    return qb_point_2D(pt.x/stretch_factor, pt.y*stretch_factor);
}

__verse electrons(quibble_point_2D pt, float time |
                  float beta = 5;
                  int num_ignore = 20;
                  float iris_size = 0.1;){

    quibble_pcolor_rgba8888 clr = qb_pcolor_rgba8888(0,0,0,1,0.4);
    pt.y += (beta)*pt.x*pt.x*0.33333;
    pt.x *= iris_size*iris_size*0.5;
    pt.y *= iris_size*iris_size*0.5;



    quibble_point_2D out_pt = pt;

    float stretch_factor = 1.5;

    if (time > TIME_B1 && time < TIME_B5){
        pt.y -= 3*iris_size*iris_size * (time - TIME_B1)/(TIME_B5 - TIME_B1);
        histogram_output_prgba8888(pt, clr, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);
        
        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);
        
        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);
 
        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);
    }

    if (time >= TIME_B5 && time < TIME_B8){
        pt.y -= 3*iris_size*iris_size;
        pt = rotate_about_origin(pt, M_PI*(time - TIME_B5));
        histogram_output_prgba8888(pt, clr, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        histogram_output_prgba8888(pt, clr, cam, qpix);

    }

    if (time >= TIME_B8 && time < TIME_B11){
        pt.y -= 3*iris_size*iris_size;

        stretch_factor = 1 + 0.5*(time-TIME_B8)/(TIME_B11-TIME_B8);

        pt = rotate_about_origin(pt, M_PI*(time-TIME_B5));
        out_pt = stretch(pt, stretch_factor);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate_about_origin(out_pt, M_PI/3);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate_about_origin(out_pt, 2*M_PI/3);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate_about_origin(out_pt, M_PI/3);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate_about_origin(out_pt, 2*M_PI/3);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

    }

    if (time >= TIME_B11){
        pt.y -= 3*iris_size*iris_size;

        stretch_factor = 1.5;

        pt = rotate_about_origin(pt, M_PI*(time-TIME_B5));
        out_pt = stretch(pt, stretch_factor);
        if (out_pt.y > -qcam.world_size_y*0.5*openness){
            histogram_output_prgba8888(out_pt, qcolor, cam, qpix);
        }

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate_about_origin(out_pt, M_PI/3);
        if (out_pt.y > -qcam.world_size_y*0.5*openness){
            histogram_output_prgba8888(out_pt, qcolor, cam, qpix);
        }

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate_about_origin(out_pt, 2*M_PI/3);
        if (out_pt.y > -qcam.world_size_y*0.5*openness){
            histogram_output_prgba8888(out_pt, qcolor, cam, qpix);
        }

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        if (out_pt.y > -qcam.world_size_y*0.5*openness){
            histogram_output_prgba8888(out_pt, qcolor, cam, qpix);
        }

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate_about_origin(out_pt, M_PI/3);
        if (out_pt.y > -qcam.world_size_y*0.5*openness){
            histogram_output_prgba8888(out_pt, qcolor, cam, qpix);
        }

        pt = rotate_about_origin(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate_about_origin(out_pt, 2*M_PI/3);
        if (out_pt.y > -qcam.world_size_y*0.5*openness){
            histogram_output_prgba8888(out_pt, qcolor, cam, qpix);
        }

    }


/*
    if (_i > num_ignore){
        pt = rotate(pt, M_PI*time);
        out_pt = stretch(pt, stretch_factor);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate(out_pt, M_PI/3);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate(out_pt, 2*M_PI/3);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate(out_pt, M_PI/3);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);

        pt = rotate(pt, M_PI/3);
        out_pt = stretch(pt, stretch_factor);
        out_pt = rotate(out_pt, 2*M_PI/3);
        histogram_output_prgba8888(out_pt, qcolor, cam, qpix);
    }
*/
}

__verse reflection(quibble_point_2D pt |
                   float iris_size = 0.25; int num_ignore = 20;
                   float openness = 1; float separation = 0.25;){

    quibble_pcolor_rgba8888 reflection_color = qb_pcolor_rgba8888(1,1,1,1,0.6);

    // constructing smaller circle
    pt.x *= 0.15;
    pt.y *= 0.15;

    // shifting to the right
    pt.x += 0.5;

    float r = sqrt(pt.x*pt.x + pt.y*pt.y);
    float theta = atan2(pt.y, pt.x);

    // smearing angularly
    theta *= 2;
 
    // rotating to the right position
    theta -= 0.75*M_PI;

    pt.x = r*cos(theta);
    pt.y = r*sin(theta);

    pt.x *= iris_size*iris_size;
    pt.y *= iris_size*iris_size;

    if (_i > num_ignore && pt.y > -qcam.world_size_y*0.5*openness){
        histogram_output_prgba8888(pt, reflection_color, qcam, qpix);
    }

}

