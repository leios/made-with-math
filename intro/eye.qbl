__verse reflection(quibble_point_2D pt |
                   float iris_size = 0.25; int num_ignore = 20;
                   float openness = 1; float separation = 0.25;){

    quibble_pcolor_rgba8888 reflection_color = qb_pcolor_rgba8888(1,1,1,1,0.6);

    // constructing smaller circle
    pt.x *= 0.15;
    pt.y *= 0.15;

    // shifting to the right
    pt.x += 0.5;

    float r = sqrt(pt.x*pt.x + pt.y*pt.y);
    float theta = atan2(pt.y, pt.x);

    // smearing angularly
    theta *= 2;
 
    // rotating to the right position
    theta -= 0.75*M_PI;

    pt.x = r*cos(theta);
    pt.y = r*sin(theta);

    pt.x *= iris_size;
    pt.y *= iris_size;

    if (time >= TIME_B2 && time < TIME_B3){
        pt.x -= 0.4*(time - TIME_B2)/(TIME_B3-TIME_B2);
    }
    else if (time >= TIME_B3 && time < TIME_B6){
        pt.x += -0.4 + 0.8*(time - TIME_B3)/(TIME_B6-TIME_B3);
        float midpoint_time = 0.5*(TIME_B6 + TIME_B3);
        float ratio;
        if (time < midpoint_time){
            ratio = 1 + 0.25*(1-(midpoint_time - time)/(midpoint_time - TIME_B3));
            pt.x *= ratio;
            pt.y /= ratio;
        } else{
            ratio = 1.25 - 0.25*(time-midpoint_time)/(TIME_B6-midpoint_time);
            pt.x *= ratio;
            pt.y /= ratio;
        }
    }
    else if (time >= TIME_B6 && time < TIME_B7){
        pt.x += 0.4 - 0.4*(time - TIME_B6)/(TIME_B7-TIME_B6);
    }


    if (_i > num_ignore){
        histogram_output_prgba8888(pt, reflection_color, qcam, qpix);
    }

}

